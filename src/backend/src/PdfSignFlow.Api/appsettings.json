{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/pdf-sign-flow.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Storage": {
    "RootPath": "App_Data/files"
  },
  "Jwt": {
    "Issuer": "pdf-sign-flow",
    "Audience": "pdf-sign-flow",
    "AccessTokenMinutes": 60
  }
}
